        let currentLang = 'uk';

        function switchPage(pageId) {
            document.querySelectorAll('.page-section').forEach(el => {
                el.classList.remove('active');
            });
            const target = document.getElementById('page-' + pageId);
            if (target) {
                target.classList.add('active');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
            
            // Highlight active nav button
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-brand-600', 'bg-brand-50');
                if (btn.getAttribute('data-nav') === pageId) {
                    btn.classList.add('text-brand-600', 'bg-brand-50');
                }
            });
        }

        function changeLanguage(lang) {
            currentLang = lang;
            document.getElementById('langSelect').value = lang;
            
            // Translate elements with data-i18n
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang] && translations[lang][key]) {
                    el.textContent = translations[lang][key];
                }
            });

            // Translate placeholders
            document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
                const key = el.getAttribute('data-i18n-placeholder');
                if (translations[lang] && translations[lang][key]) {
                    el.placeholder = translations[lang][key];
                }
            });

            showToast(lang === 'uk' ? 'Мову змінено на українську' : 'Language updated successfully');
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-msg').textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function handleQuickLead(e) {
            e.preventDefault();
            const name = document.getElementById('qlName').value;
            showToast(currentLang === 'uk' ? `Дякуємо, ${name}! Заявку прийнято.` : `Thank you, ${name}! Request received.`);
            e.target.reset();
        }

        function handleContactForm(e) {
            e.preventDefault();
            showToast(currentLang === 'uk' ? 'Повідомлення успішно надіслано!' : 'Message sent successfully!');
            e.target.reset();
        }

        function calculateTotal() {
            const basePrice = parseFloat(document.getElementById('calcService').value) || 0;
            const qty = parseInt(document.getElementById('calcQty').value) || 1;
            let total = basePrice * qty;

            if (document.getElementById('optUrgent').checked) {
                total += 30;
            }
            if (document.getElementById('optMaterials').checked) {
                total += 50;
            }

            document.getElementById('totalPrice').textContent = '€' + total;
        }

        function submitBooking() {
            const total = document.getElementById('totalPrice').textContent;
            showToast(currentLang === 'uk' ? `Розрахунок на суму ${total} успішно збережено! Ми зв'яжемося з вами.` : `Estimate of ${total} saved successfully! We will contact you.`);
        }

        // Initialize calculator on load
        window.onload = function() {
            calculateTotal();
        };
    </script>
